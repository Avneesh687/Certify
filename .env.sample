# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Will fallback to In-Memory MongoDB if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/certify_db

# JWT Secret
JWT_SECRET=certify_super_secret_jwt_key_2026

# Frontend Application URL for QR Code Verification Links
FRONTEND_URL=http://localhost:5173

# Nodemailer SMTP Configuration (Optional - falls back to Ethereal test transporter if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Certify System" <no-reply@certify.com>

# Optional Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
